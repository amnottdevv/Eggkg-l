# emulator CHIP-8 — sumber tunggal (dialect mtcc, tanpa #include),
# build.ruf ikut sebagai entri (resep diutamakan di atas turunan kanonik),
# plus ROM contoh .c8 yang mendarat di .local/emu-ch8/src/ (data, bukan
# source — walker mtcc hanya mengambil ekstensi .c).
emu-ch8 = ["https://github.com/amnottdevv/Eggkg-l/blob/main/emu-ch8/build.ruf", "https://github.com/amnottdevv/Eggkg-l/blob/main/emu-ch8/emu-ch8.c", "https://github.com/amnottdevv/Eggkg-l/blob/main/emu-ch8/bounce.c8"]
